{
  "name": "crud-starter",
  "displayName": "CRUD Starter（界面化增删改查模板）",
  "description": "VSCode 插件初始化项目：提供界面化增删改查操作（侧边栏树视图 + Webview 表单 + 全套菜单/右键菜单示例），数据源可替换，开箱即用、易于扩展。",
  "version": "0.2.1",
  "publisher": "your-publisher",
  "keywords": [
    "crud",
    "starter",
    "template",
    "webview",
    "tree view",
    "context menu"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crudStarter",
          "title": "CRUD Starter",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "crudStarter": [
        {
          "id": "crudStarter.itemsView",
          "name": "条目列表"
        }
      ]
    },
    "commands": [
      {
        "command": "crudStarter.newItem",
        "title": "新增条目",
        "category": "CRUD Starter",
        "icon": "$(add)"
      },
      {
        "command": "crudStarter.editItem",
        "title": "编辑条目",
        "category": "CRUD Starter",
        "icon": "$(edit)"
      },
      {
        "command": "crudStarter.duplicateItem",
        "title": "克隆条目",
        "category": "CRUD Starter",
        "icon": "$(copy)"
      },
      {
        "command": "crudStarter.deleteItem",
        "title": "删除条目",
        "category": "CRUD Starter",
        "icon": "$(trash)"
      },
      {
        "command": "crudStarter.filterItems",
        "title": "过滤条目",
        "category": "CRUD Starter",
        "icon": "$(search)"
      },
      {
        "command": "crudStarter.refresh",
        "title": "刷新列表",
        "category": "CRUD Starter",
        "icon": "$(refresh)"
      },
      {
        "command": "crudStarter.openDataFile",
        "title": "打开数据文件",
        "category": "CRUD Starter"
      },
      {
        "command": "crudStarter.newItemFromSelection",
        "title": "从选中文本新增条目",
        "category": "CRUD Starter",
        "icon": "$(symbol-string)"
      },
      {
        "command": "crudStarter.newItemFromFile",
        "title": "将文件添加为条目",
        "category": "CRUD Starter",
        "icon": "$(new-file)"
      },
      {
        "command": "crudStarter.setPriorityHigh",
        "title": "优先级：高",
        "category": "CRUD Starter",
        "icon": "$(arrow-up)"
      },
      {
        "command": "crudStarter.setPriorityMedium",
        "title": "优先级：中",
        "category": "CRUD Starter",
        "icon": "$(dash)"
      },
      {
        "command": "crudStarter.setPriorityLow",
        "title": "优先级：低",
        "category": "CRUD Starter",
        "icon": "$(arrow-down)"
      },
      {
        "command": "crudStarter.copyName",
        "title": "复制名称",
        "category": "CRUD Starter",
        "icon": "$(copy)"
      },
      {
        "command": "crudStarter.copyMarkdown",
        "title": "复制为 Markdown",
        "category": "CRUD Starter",
        "icon": "$(markdown)"
      },
      {
        "command": "crudStarter.copyJson",
        "title": "复制为 JSON",
        "category": "CRUD Starter",
        "icon": "$(bracket)"
      },
      {
        "command": "crudStarter.moreActions",
        "title": "更多操作…",
        "category": "CRUD Starter",
        "icon": "$(ellipsis)"
      }
    ],
    "submenus": [
      {
        "id": "crudStarter.priorityMenu",
        "label": "设置优先级"
      },
      {
        "id": "crudStarter.copyMenu",
        "label": "复制…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crudStarter.newItem",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.filterItems",
          "group": "navigation@2"
        },
        {
          "command": "crudStarter.refresh",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "crudStarter.editItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.editItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@1"
        },
        {
          "command": "crudStarter.duplicateItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@2"
        },
        {
          "command": "crudStarter.deleteItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@3"
        },
        {
          "submenu": "crudStarter.priorityMenu",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "2_crud@1"
        },
        {
          "submenu": "crudStarter.copyMenu",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "2_crud@2"
        },
        {
          "command": "crudStarter.moreActions",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "3_crud@1"
        }
      ],
      "crudStarter.priorityMenu": [
        {
          "command": "crudStarter.setPriorityHigh",
          "group": "1@1"
        },
        {
          "command": "crudStarter.setPriorityMedium",
          "group": "1@2"
        },
        {
          "command": "crudStarter.setPriorityLow",
          "group": "1@3"
        }
      ],
      "crudStarter.copyMenu": [
        {
          "command": "crudStarter.copyName",
          "group": "1@1"
        },
        {
          "command": "crudStarter.copyMarkdown",
          "group": "1@2"
        },
        {
          "command": "crudStarter.copyJson",
          "group": "1@3"
        }
      ],
      "editor/context": [
        {
          "command": "crudStarter.newItemFromSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_crudstarter@1"
        }
      ],
      "explorer/context": [
        {
          "command": "crudStarter.newItemFromFile",
          "group": "9_crudstarter@1"
        }
      ],
      "editor/title": [
        {
          "command": "crudStarter.newItemFromFile",
          "when": "editorIsOpen",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "crudStarter.newItem",
        "key": "alt+n"
      },
      {
        "command": "crudStarter.newItemFromSelection",
        "key": "alt+s",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "CRUD Starter",
      "properties": {
        "crudStarter.storagePath": {
          "type": "string",
          "default": ".vscode/crud-starter-items.json",
          "description": "数据存储的 JSON 文件路径（相对当前工作区根目录，使用 / 分隔）。未打开工作区时数据保存在 VSCode 全局存储中。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests",
    "test": "node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "mocha": "^10.7.0",
    "typescript": "^5.5.4"
  }
}
