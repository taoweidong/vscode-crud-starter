{
  "name": "vscode-starter-template",
  "displayName": "CRUD Starter（界面化增删改查模板）",
  "description": "VSCode 插件初始化项目：提供界面化增删改查操作（侧边栏树视图 + Webview 表单 + 全套菜单/右键菜单示例），数据源可替换，开箱即用、易于扩展。",
  "version": "0.6.1",
  "publisher": "your-publisher",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoweidong/vscode-starter-template.git"
  },
  "keywords": [
    "crud",
    "starter",
    "template",
    "webview",
    "tree view",
    "context menu"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "crudStarter",
          "title": "CRUD Starter",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "crudStarter": [
        {
          "id": "crudStarter.itemsView",
          "name": "条目列表"
        },
        {
          "id": "crudStarter.envView",
          "name": "环境信息"
        },
        {
          "id": "crudStarter.initView",
          "name": "环境初始化"
        },
        {
          "id": "crudStarter.featureConfigView",
          "name": "特性配置"
        },
        {
          "id": "crudStarter.staticConfigView",
          "name": "静态配置"
        },
        {
          "id": "crudStarter.buildView",
          "name": "分支编译"
        }
      ]
    },
    "commands": [
      {
        "command": "crudStarter.newItem",
        "title": "新增条目",
        "category": "CRUD Starter",
        "icon": "$(add)"
      },
      {
        "command": "crudStarter.editItem",
        "title": "编辑条目",
        "category": "CRUD Starter",
        "icon": "$(edit)"
      },
      {
        "command": "crudStarter.duplicateItem",
        "title": "克隆条目",
        "category": "CRUD Starter",
        "icon": "$(copy)"
      },
      {
        "command": "crudStarter.deleteItem",
        "title": "删除条目",
        "category": "CRUD Starter",
        "icon": "$(trash)"
      },
      {
        "command": "crudStarter.filterItems",
        "title": "过滤条目",
        "category": "CRUD Starter",
        "icon": "$(search)"
      },
      {
        "command": "crudStarter.refresh",
        "title": "刷新列表",
        "category": "CRUD Starter",
        "icon": "$(refresh)"
      },
      {
        "command": "crudStarter.openDataFile",
        "title": "打开数据文件",
        "category": "CRUD Starter"
      },
      {
        "command": "crudStarter.newItemFromSelection",
        "title": "从选中文本新增条目",
        "category": "CRUD Starter",
        "icon": "$(symbol-string)"
      },
      {
        "command": "crudStarter.newItemFromFile",
        "title": "将文件添加为条目",
        "category": "CRUD Starter",
        "icon": "$(new-file)"
      },
      {
        "command": "crudStarter.newItemFromFilePreview",
        "title": "登记文件并摘录内容",
        "category": "CRUD Starter",
        "icon": "$(markdown)"
      },
      {
        "command": "crudStarter.newItemsFromFolder",
        "title": "将文件夹内容登记为条目",
        "category": "CRUD Starter",
        "icon": "$(folder-library)"
      },
      {
        "command": "crudStarter.quickAddFromSelection",
        "title": "从选中文本快速新增条目",
        "category": "CRUD Starter",
        "icon": "$(zap)"
      },
      {
        "command": "crudStarter.appendSelectionToItem",
        "title": "将选中内容追加到条目",
        "category": "CRUD Starter",
        "icon": "$(add)"
      },
      {
        "command": "crudStarter.addCurrentFileToItems",
        "title": "登记当前文件为条目",
        "category": "CRUD Starter",
        "icon": "$(new-file)"
      },
      {
        "command": "crudStarter.setPriorityHigh",
        "title": "优先级：高",
        "category": "CRUD Starter",
        "icon": "$(arrow-up)"
      },
      {
        "command": "crudStarter.setPriorityMedium",
        "title": "优先级：中",
        "category": "CRUD Starter",
        "icon": "$(dash)"
      },
      {
        "command": "crudStarter.setPriorityLow",
        "title": "优先级：低",
        "category": "CRUD Starter",
        "icon": "$(arrow-down)"
      },
      {
        "command": "crudStarter.copyName",
        "title": "复制名称",
        "category": "CRUD Starter",
        "icon": "$(copy)"
      },
      {
        "command": "crudStarter.copyMarkdown",
        "title": "复制为 Markdown",
        "category": "CRUD Starter",
        "icon": "$(markdown)"
      },
      {
        "command": "crudStarter.copyJson",
        "title": "复制为 JSON",
        "category": "CRUD Starter",
        "icon": "$(bracket)"
      },
      {
        "command": "crudStarter.moreActions",
        "title": "更多操作…",
        "category": "CRUD Starter",
        "icon": "$(ellipsis)"
      },
      {
        "command": "crudStarter.refreshEnvironment",
        "title": "刷新环境信息",
        "category": "CRUD Starter",
        "icon": "$(refresh)"
      },
      {
        "command": "crudStarter.showEnvironmentOutput",
        "title": "打开环境信息输出",
        "category": "CRUD Starter",
        "icon": "$(output)"
      },
      {
        "command": "crudStarter.runAllInit",
        "title": "全部初始化",
        "category": "CRUD Starter",
        "icon": "$(checklist)"
      },
      {
        "command": "crudStarter.runInitStep",
        "title": "执行初始化步骤",
        "category": "CRUD Starter",
        "icon": "$(play)"
      },
      {
        "command": "crudStarter.openFeatureConfigPage",
        "title": "打开特性配置页面",
        "category": "CRUD Starter",
        "icon": "$(gear)"
      },
      {
        "command": "crudStarter.toggleFeature",
        "title": "切换特性开关",
        "category": "CRUD Starter"
      },
      {
        "command": "crudStarter.openStaticConfigFile",
        "title": "打开静态配置文件",
        "category": "CRUD Starter",
        "icon": "$(go-to-file)"
      },
      {
        "command": "crudStarter.buildBranch",
        "title": "选择分支编译出包",
        "category": "CRUD Starter",
        "icon": "$(package)"
      }
    ],
    "submenus": [
      {
        "id": "crudStarter.priorityMenu",
        "label": "设置优先级"
      },
      {
        "id": "crudStarter.copyMenu",
        "label": "复制…"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "crudStarter.newItem",
          "when": "view == crudStarter.itemsView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.filterItems",
          "when": "view == crudStarter.itemsView",
          "group": "navigation@2"
        },
        {
          "command": "crudStarter.refresh",
          "when": "view == crudStarter.itemsView",
          "group": "navigation@3"
        },
        {
          "command": "crudStarter.refreshEnvironment",
          "when": "view == crudStarter.envView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.showEnvironmentOutput",
          "when": "view == crudStarter.envView",
          "group": "navigation@2"
        },
        {
          "command": "crudStarter.runAllInit",
          "when": "view == crudStarter.initView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.openFeatureConfigPage",
          "when": "view == crudStarter.featureConfigView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.openStaticConfigFile",
          "when": "view == crudStarter.staticConfigView",
          "group": "navigation@1"
        },
        {
          "command": "crudStarter.buildBranch",
          "when": "view == crudStarter.buildView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "crudStarter.editItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.runInitStep",
          "when": "view == crudStarter.initView && viewItem == initStep",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.buildBranch",
          "when": "view == crudStarter.buildView && viewItem == buildBranch",
          "group": "inline@1"
        },
        {
          "command": "crudStarter.editItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@1"
        },
        {
          "command": "crudStarter.duplicateItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@2"
        },
        {
          "command": "crudStarter.deleteItem",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "1_crud@3"
        },
        {
          "submenu": "crudStarter.priorityMenu",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "2_crud@1"
        },
        {
          "submenu": "crudStarter.copyMenu",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "2_crud@2"
        },
        {
          "command": "crudStarter.moreActions",
          "when": "view == crudStarter.itemsView && viewItem == crudItem",
          "group": "3_crud@1"
        }
      ],
      "crudStarter.priorityMenu": [
        {
          "command": "crudStarter.setPriorityHigh",
          "group": "1@1"
        },
        {
          "command": "crudStarter.setPriorityMedium",
          "group": "1@2"
        },
        {
          "command": "crudStarter.setPriorityLow",
          "group": "1@3"
        }
      ],
      "crudStarter.copyMenu": [
        {
          "command": "crudStarter.copyName",
          "group": "1@1"
        },
        {
          "command": "crudStarter.copyMarkdown",
          "group": "1@2"
        },
        {
          "command": "crudStarter.copyJson",
          "group": "1@3"
        }
      ],
      "editor/context": [
        {
          "command": "crudStarter.newItemFromSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_crudstarter@1"
        },
        {
          "command": "crudStarter.quickAddFromSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_crudstarter@2"
        },
        {
          "command": "crudStarter.appendSelectionToItem",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_crudstarter@3"
        },
        {
          "command": "crudStarter.addCurrentFileToItems",
          "when": "editorIsOpen && !editorHasSelection",
          "group": "9_crudstarter@4"
        }
      ],
      "explorer/context": [
        {
          "command": "crudStarter.newItemFromFile",
          "group": "9_crudstarter@1"
        },
        {
          "command": "crudStarter.newItemFromFilePreview",
          "when": "!explorerResourceIsFolder",
          "group": "9_crudstarter@2"
        },
        {
          "command": "crudStarter.newItemsFromFolder",
          "when": "explorerResourceIsFolder",
          "group": "9_crudstarter@3"
        }
      ],
      "editor/title": [
        {
          "command": "crudStarter.newItemFromFile",
          "when": "editorIsOpen",
          "group": "navigation@5"
        }
      ]
    },
    "keybindings": [
      {
        "command": "crudStarter.newItem",
        "key": "alt+n"
      },
      {
        "command": "crudStarter.newItemFromSelection",
        "key": "alt+s",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "CRUD Starter",
      "properties": {
        "crudStarter.storagePath": {
          "type": "string",
          "default": ".vscode/crud-starter-items.json",
          "description": "数据存储的 JSON 文件路径（相对当前工作区根目录，使用 / 分隔）。未打开工作区时数据保存在 VSCode 全局存储中。"
        },
        "crudStarter.runStartupTasks": {
          "type": "boolean",
          "default": true,
          "description": "插件激活时自动执行启动任务（环境检测脚本）。关闭后仍可通过「环境信息」视图的刷新按钮手动执行。"
        },
        "crudStarter.features.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "特性开关：删除条目时弹出模态确认框，防止误删。"
        },
        "crudStarter.features.successNotifications": {
          "type": "boolean",
          "default": true,
          "description": "特性开关：新增 / 更新 / 删除 / 克隆成功后弹出提示。"
        },
        "crudStarter.features.showPriorityIcons": {
          "type": "boolean",
          "default": true,
          "description": "特性开关：条目列表中按优先级显示 ↑ / — / ↓ 图标。"
        },
        "crudStarter.features.showViewBadges": {
          "type": "boolean",
          "default": true,
          "description": "特性开关：过滤时在视图标题栏显示匹配数量徽标。"
        },
        "crudStarter.features.autoRefreshOnExternalChange": {
          "type": "boolean",
          "default": true,
          "description": "特性开关：数据文件 / 静态配置被外部修改时自动重新加载。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests",
    "test": "node out/test/runTest.js",
    "gate": "node scripts/gate.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "mocha": "^10.7.0",
    "typescript": "^5.5.4"
  }
}
